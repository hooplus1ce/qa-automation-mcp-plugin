# QA Automation MCP — 环境变量模板
# 用法: cp .env.example .env, 按需修改 (服务器启动时自动加载, 见 src/qa_mcp/config.py)

# 物理 Chrome 远程调试端口 (需以 --remote-debugging-port=9222 启动)
CDP_URL=http://127.0.0.1:9222

# 鼠标光标可视化 + 目标高亮 服务级默认开关
# 取值: true/false; click_interact 的 visualize 参数可对单次调用强制覆盖
VISUAL_EFFECTS=true

# GLM-5V 多模态视觉 API Key (describe_image 工具的图片识别代理用)
# 接入: 腾讯云 TokenHub (OpenAI 兼容, base_url=https://tokenhub.tencentmaas.com/v1)
# 未配置时 describe_image 会明确报错; 优先级: 进程环境变量 > 本 .env 文件
VISION_API_KEY=

# 腾讯文档 MCP token (docs.qq.com/openapi/mcp 的 Authorization 头)
# 获取: 腾讯文档空间列表页 → 右上角「≡」→ 使用MCP → 获取MCP token (需超级会员, 有效期一年)
# 注意: Claude Code 暂不支持在 .mcp.json/plugin.json 的 headers 中展开 ${VAR},
#       此变量仅作本地记录, json 配置中需填入真实 token 值
TENCENT_DOCS_MCP_TOKEN=



PYTHONUNBUFFERED=1
